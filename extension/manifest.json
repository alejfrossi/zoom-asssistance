{
  "manifest_version": 3,
  "name": "Zoom Attendance Tracker",
  "version": "2.0",
  "description": "Tomá asistencia automáticamente en reuniones de Zoom. Compará los participantes con tu lista de alumnos y descargá un reporte CSV con asistencia y estado de cámara.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Zoom Attendance Tracker"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.zoom.us/*"
  ]
}